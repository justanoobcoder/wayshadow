# Maintainer: justanoobcoder <syaorancode@gmail.com>
pkgname=keypop
pkgver=0.1.0
pkgrel=1
pkgdesc="A lightweight, elegant keystroke visualizer for Wayland compositors"
arch=('x86_64' 'aarch64')
url="https://github.com/justanoobcoder/keypop"
license=('MIT')
depends=(
    'wayland'
    'cairo'
    'pango'
    'libinput'
    'libxkbcommon'
    'gtk3'
    'libappindicator'
)
makedepends=(
    'wayland-protocols'
    'pkg-config'
    'gcc'
    'make'
    'git'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')
options=(!debug)

build() {
    cd "$pkgname-$pkgver"
    make WAYLAND_PROTOCOLS_DIR=/usr/share/wayland-protocols \
         GIT_COMMIT="$pkgver"
}

check() {
    cd "$pkgname-$pkgver"
    make test WAYLAND_PROTOCOLS_DIR=/usr/share/wayland-protocols
}

package() {
    cd "$pkgname-$pkgver"
    make install \
         DESTDIR="$pkgdir" \
         WAYLAND_PROTOCOLS_DIR=/usr/share/wayland-protocols

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
